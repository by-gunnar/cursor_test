{
    "family": "myfirstpage",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
      "FARGATE"
    ],
    "containerDefinitions": [
        {
            "name": "main",
            "image": "image",
            "repositoryCredentials": {
                "credentialsParameter": ""
            },
            "cpu": 256,
            "memory": 512,
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp",
                    "name": "",
                    "appProtocol": "http",
                    "containerPortRange": ""
                }
            ],
            "essential": true,
            "startTimeout": 2,
            "stopTimeout": 2,
            "privileged": false,
            "readonlyRootFilesystem": true,
            "interactive": true,
            "pseudoTerminal": true,
            "ulimits": [
                {
                    "name": "core",
                    "softLimit": 0,
                    "hardLimit": 0
                }
            ]
        }
    ],
    "pidMode": "host"
}
