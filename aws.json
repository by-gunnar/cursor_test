{
    "family": "myfirstpage",
    "taskRoleArn": "",
    "executionRoleArn": "",
    "networkMode": "bridge",
    "containerDefinitions": [
        {
            "name": "main",
            "image": "image",
            "repositoryCredentials": {
                "credentialsParameter": ""
            },
            "cpu": 256,
            "memory": 512,
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 0,
                    "protocol": "tcp",
                    "name": "",
                    "appProtocol": "http",
                    "containerPortRange": ""
                }
            ],
            "essential": true,
            "startTimeout": 2,
            "stopTimeout": 2,
            "disableNetworking": true,
            "privileged": true,
            "readonlyRootFilesystem": true,
            "interactive": true,
            "pseudoTerminal": true,
            "ulimits": [
                {
                    "name": "core",
                    "softLimit": 0,
                    "hardLimit": 0
                }
            ],
            "logConfiguration": {
                "logDriver": "json-file",
                "options": {
                    "KeyName": ""
                },
                "secretOptions": [
                    {
                        "name": "",
                        "valueFrom": ""
                    }
                ]
            }
        }
    ],
    "pidMode": "host",
    "ipcMode": "host",
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "WINDOWS_SERVER_2019_FULL"
    }
}
